# ==============================================================================
# RentSpace — Premium Living. Smarter Renting.
# Production & Cloud Environment Configuration
# ==============================================================================

# Server Listening Port (Default: 3000)
PORT=3000

# Base Application URL
APP_URL="http://localhost:3000"

# ==============================================================================
# MONGODB ATLAS DATABASE CONFIGURATION (Mandatory Application Database)
# ==============================================================================
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/rentspace?retryWrites=true&w=majority
#
# HOW TO CONFIGURE IN MONGODB ATLAS:
# 1. Create a free M0 cluster on MongoDB Atlas (https://www.mongodb.com/cloud/atlas).
# 2. Under Database Access, create a database user (e.g. rentspace_admin) and secure password.
# 3. Under Network Access, click 'Add IP Address' and choose 'ALLOW ACCESS FROM ANYWHERE' (0.0.0.0/0).
#    * Crucial: Cloud run containers and dynamic environments require 0.0.0.0/0; otherwise
#      Atlas firewall rejects incoming TLS connections with "SSL alert number 80".
# 4. Under Clusters -> Connect -> 'Drivers' (Node.js), copy the connection string.
# 5. Ensure the database name is set to 'rentspace' in the connection URI path.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/rentspace?retryWrites=true&w=majority"

# Authentication Token Secret (Used to cryptographically sign user sessions)
JWT_SECRET="rentspace_production_vault_auth_secret_key_928340129"

# ==============================================================================
# REAL CLOUD IMAGE STORAGE (Optional Cloudinary Integration)
# ==============================================================================
# When configured, owner-uploaded property photographs from user devices are
# processed, optimized, and served via Cloudinary CDN.
# When omitted, images are securely stored in the server's local /public/uploads directory.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Environment Mode
NODE_ENV="development"
